# ==============================================================================
# INSTITUTO ALBERTINO VIEIRA SANTOS - CASA JANE
# Arquivo de Exemplo de Configuração de Ambiente (.env)
# Domínio Oficial: https://institutocasajane.com.br
# ==============================================================================

# Porta na qual o servidor Node.js responderá
PORT=3001

# Ambiente de execução ('development' para local ou 'production' para a web)
NODE_ENV=production

# String de Conexão com o Banco de Dados PostgreSQL
# Local: postgresql://postgres:senha@localhost:5432/instituto_casa_jane
# Produção (ex: Supabase, Neon, Render): postgresql://user:senha@host:5432/db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/instituto_casa_jane
DATABASE_SSL=false

# Chave Secreta para Assinatura de Tokens JWT (Gere uma chave longa e aleatória para produção!)
# Exemplo no terminal Linux/Mac/Git Bash: openssl rand -base64 48
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria_com_mais_de_32_caracteres

# URL do Frontend autorizada pelo CORS
# Em produção: https://institutocasajane.com.br
FRONTEND_URL=https://institutocasajane.com.br

# Diretório para armazenamento de uploads (fotos e documentos)
UPLOAD_DIR=./uploads
